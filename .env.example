# Copier en .env et remplir. Ne jamais versionner le fichier .env.

# Clé partagée entre n8n et le moteur (en-tête X-API-Key).
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MOTEUR_TOKEN=

# Clé de chiffrement des identifiants n8n. Générer de la même façon, et la garder :
# la perdre rend illisibles les identifiants SMTP enregistrés dans n8n.
N8N_ENCRYPTION_KEY=

# Version de n8n (laisser latest pour commencer, puis figer une version testée)
N8N_VERSION=latest

# URL à laquelle tu ouvres n8n. En local : http://localhost:5678/
# Sur un VPS : https://n8n.ton-domaine.fr/  (et passer N8N_SECURE_COOKIE à true)
N8N_URL_PUBLIQUE=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Résumé IA des devis (Mistral, hébergé en Europe). Laisser vide pour désactiver.
# Clé à créer sur https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
